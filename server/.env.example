PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email. Render free tier blocks SMTP ports 25/465/587, so use a provider on port 2525.
# Brevo free plan (300 emails/day): HOST=smtp-relay.brevo.com, PORT=2525.
# The EMAIL_FROM address must be verified as a sender in Brevo.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Code-a-Nova <your-verified-sender@example.com>"
# Contact-form messages are delivered here (defaults to EMAIL_USER if empty).
CONTACT_EMAIL=
OTP_EXPIRY_MINUTES=10
